<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.software.live_wallpaper" android:required="false" />
    <application>
        <service
            android:name="com.rohjoohoon.pocket_live2d_native.PocketLive2dWallpaperService"
            android:exported="true"
            android:process=":wallpaper"
            android:permission="android.permission.BIND_WALLPAPER"
            android:label="@string/pocket_live2d_wallpaper_name">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data android:name="android.service.wallpaper" android:resource="@xml/pocket_live2d_wallpaper" />
        </service>
    </application>
</manifest>
