# Copy to .env.local. Leave blank for local bundled models.
# Public R2 custom domain or r2.dev URL (never an S3 API endpoint or a secret).
VITE_MODEL_BASE_URL=
# Bare URLs use characters/<id>/model/. An explicit /models/ prefix also works.
R2_BUCKET=
PAGES_PROJECT=pocket-live2d
# Character shown at /; all characters remain accessible at /<id>.
CHARACTER=mark
