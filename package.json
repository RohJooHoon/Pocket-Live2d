{
  "name": "pocket-live2d",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Pocket Live2D: interactive character web pages (Vue 3) with tilt, shake, touch and face tracking.",
  "scripts": {
    "stage": "node tool/stage-public.mjs",
    "dev": "npm run stage && vite --host",
    "dev:https": "npm run stage -- --mode https && vite --host --mode https",
    "build": "npm run stage -- --mode production && npm run typecheck && vite build",
    "preview": "vite preview --host",
    "deploy": "node tool/deploy-cloudflare.mjs",
    "deploy:setup": "node tool/setup-local-deploy.mjs",
    "deploy:login": "npx --yes wrangler@4 login",
    "deploy:check": "npm run typecheck:sdk && npm run verify:models -- --origin https://pocket-live2d.pages.dev",
    "deploy:dry-run": "node tool/deploy-cloudflare.mjs --project pocket-live2d --dry-run",
    "deploy:pages": "node tool/deploy-cloudflare.mjs --project pocket-live2d",
    "upload:models": "node tool/upload-r2.mjs",
    "verify:models": "node tool/verify-r2.mjs",
    "model:prepare": "python3 tool/prepare_model_upload.py",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "typecheck:sdk": "vue-tsc --noEmit -p tsconfig.sdk.json",
    "test": "vitest run",
    "validate:models": "python3 tool/validate_model_assets.py"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "typescript": "~5.9.3",
    "vite": "^8.3.3",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.3.12"
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.1.0",
    "vue": "^3.5.43"
  }
}
