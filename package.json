{
  "name": "pocket-live2d",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Pocket Live2D: interactive character web pages with tilt, shake, touch and face tracking.",
  "scripts": {
    "stage": "node tool/stage-public.mjs",
    "dev": "npm run stage && vite --host",
    "dev:https": "npm run stage && vite --host --mode https",
    "build": "npm run stage && npm run typecheck && vite build",
    "preview": "vite preview --host",
    "deploy": "node tool/deploy-cloudflare.mjs",
    "model:prepare": "python3 tool/prepare_model_upload.py",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:sdk": "tsc --noEmit -p tsconfig.sdk.json",
    "test": "vitest run",
    "validate:models": "python3 tool/validate_model_assets.py"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.1.0"
  }
}
